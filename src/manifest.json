{
  "manifest_version": 21,
  "short_name": "Notebook",
  "name": "Javascript Notebook",
  "id": "net.verticesandedges.apps.twa.notebook",
  "version": "1.1.21",
  "author": "Joshua M. Moore <illogical.alliteration@gmail.com>",
  "developer": {
    "name": "Joshua M. Moore",
    "url": "https://github.com/verticesandedges"
  },
  "homepage_url": "https://github.com/verticesandedges/notebook",
  "lang": "en",
  "icons": [
    {
      "src": "icon/notebook.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon/notebook-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon/notebook-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "start_url": "/notebook/",
  "scope": "/notebook/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "offline_enabled": true,
  "background": {
    "service_worker": "sw.js"
  },
  "commands": {
    "run-cell": {
      "suggested_key": {
        "default": "Ctrl+Enter"
      },
      "description": "Execute currently focused code cell"
    }
  },
  "default_locale": "en-US",
  "description": "A client-side Javascript Notebook",
  "file_handlers": [{
    "action": "/notebook/?open-file",
    "accept": {
      "application/x-ipynb+json": [".ipynb", ".json"],
      "application/vnd.jupyter": [".ipynb", ".json"],
      "application/json": [".ipynb", ".json"]
    }
  }],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "theme_color": "#ffffff",
  "display_override": [
    "standalone",
    "minimal-ui",
    "window-controls-overlay",
    "browser",
    "fullscreen"
  ],
  "iarc_rating_id": "1019abd7-47cc-8101-8020-3f333dedea50",
  "categories": [
    "developer",
    "developer tools",
    "development",
    "education",
    "productivity"
  ],
  "screenshots": [
    {
      "src": "../static/screenshots/streaming-vega.png",
      "sizes": "768x2288",
      "type": "image/png"
    },
    {
      "src": "../static/screenshots/genetic-programming.png",
      "sizes": "1128x6286",
      "type": "image/png"
    },
    {
      "src": "../static/screenshots/readable.png",
      "sizes": "908x889",
      "type": "image/png"
    }
  ]
}
