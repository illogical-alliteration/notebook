{"manifest_version":20,"short_name":"Notebook","name":"Javascript Notebook","version":"1.1.20","author":"Joshua M. Moore <illogical.alliteration@gmail.com>","developer":{"name":"Joshua M. Moore","url":"https://github.com/verticesandedges"},"homepage_url":"https://github.com/verticesandedges/notebook","lang":"en","icons":[{"src":"/notebook/notebook.b6e807be.png","sizes":"512x512","type":"image/png","purpose":"maskable"},{"src":"/notebook/notebook-512x512.b6e807be.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/notebook/notebook-192x192.cbf32903.png","sizes":"192x192","type":"image/png","purpose":"any"}],"start_url":"https://apps.verticesandedges.net/notebook/","scope":"/notebook/","display":"standalone","orientation":"any","background_color":"#ffffff","offline_enabled":true,"background":{"service_worker":"sw.js"},"commands":{"run-cell":{"suggested_key":{"default":"Ctrl+Enter"},"description":"Execute currently focused code cell"}},"default_locale":"en-US","description":"A client-side Javascript Notebook","file_handlers":[{"action":"/notebook/?open-file","accept":{"application/x-ipynb+json":[".ipynb",".json"],"application/vnd.jupyter":[".ipynb",".json"],"application/json":[".ipynb",".json"]}}],"launch_handler":{"client_mode":"navigate-new"},"theme_color":"#ffffff","display_override":["standalone","minimal-ui","window-controls-overlay","browser","fullscreen"],"iarc_rating_id":"1019abd7-47cc-8101-8020-3f333dedea50","categories":["developer","developer tools","development","education","productivity"],"screenshots":[{"src":"/notebook/streaming-vega.7d582e55.png","sizes":"768x2288","type":"image/png"},{"src":"/notebook/genetic-programming.309efe20.png","sizes":"1128x6286","type":"image/png"},{"src":"/notebook/readable.1d16c55d.png","sizes":"908x889","type":"image/png"}]}