{
  "name": "notebook",
  "version": "1.1.20",
  "description": "A JS/TS/MD notebook with live markdown fields",
  "keywords": [
    "js",
    "ts",
    "md",
    "notebook"
  ],
  "license": "UNLICENSED",
  "author": "Joshua M. Moore <illogical.alliteration@gmail.com>",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf .parcel-cache dist",
    "build": "parcel build --public-url /notebook/",
    "start": "parcel src/index.html --port 8080 --public-url /notebook/"
  },
  "serviceWorker": "dist/sw.js",
  "targets": {
    "main": false,
    "app": {
      "source": "src/index.html",
      "distDir": "dist/"
    }
  },
  "pluginOptions": {
    "staticFiles": {
      "staticPath": [
        {
          "src": "examples",
          "outDir": "."
        },
        {
          "src": "screenshots",
          "outDir": "."
        }
      ]
    }
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/service-worker": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "license-checker-rseidelsohn": "^4.4.2",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "process": "^0.11.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/markdown": "^1.6.3",
    "codemirror": "^6.0.2",
    "katex": "^0.16.45",
    "lowlight": "^3.3.0",
    "marked": "^18.0.11",
    "typescript": "^6.0.3"
  }
}
