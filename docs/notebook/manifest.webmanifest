{"manifest_version":9,"short_name":"Notebook","name":"Javascript Notebook","version":"1.0.14","author":"Joshua M. Moore <illogical.alliteration@gmail.com>","developer":{"name":"Joshua M. Moore","url":"https://github.com/verticesandedges"},"homepage_url":"https://github.com/verticesandedges/notebook","lang":"en","icons":[{"src":"/notebook/notebook.b6e807be.png","sizes":"512x512","type":"image/png","purpose":"maskable"},{"src":"/notebook/notebook-512x512.b6e807be.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/notebook/notebook-192x192.cbf32903.png","sizes":"192x192","type":"image/png","purpose":"any"}],"start_url":"http://127.0.0.1:8080/notebook/","scope":"/notebook/","display":"standalone","orientation":"any","background_color":"#ffffff","offline_enabled":true,"background":{"scripts":["service-worker.js"],"service_worker":["service-worker.js"]},"commands":{"run-cell":{"suggested_key":{"default":"Ctrl+Enter"},"description":"Execute currently focused code cell"}},"default_locale":"en-US","description":"A client-side Javascript Notebook","file_handlers":[{"action":"/notebook/?open-file","accept":{"application/x-ipynb+json":[".ipynb",".json"],"application/vnd.jupyter":[".ipynb",".json"],"application/json":[".ipynb",".json"]}}],"launch_handler":{"client_mode":"navigate-new"}}